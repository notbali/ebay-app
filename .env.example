# --- AI provider ---
# Which service drafts listings. "nvidia" (a free vision model on NVIDIA's NIM tier) or
# "claude" (Anthropic, requires ANTHROPIC_API_KEY below). "kimi" is accepted as a legacy alias
# for "nvidia". See services/aiService.js.
AI_PROVIDER=nvidia

# --- NVIDIA NIM (free tier, ~40 req/min) ---
# Get a key at https://build.nvidia.com (sign up free, then Account > API Keys)
NVIDIA_API_KEY=your-nvidia-api-key
# Optional: override the models (defaults are set in services/nvidiaService.js). NVIDIA retires
# catalog models often and not every model is provisioned for every account (a "404 Function not
# found for account" means this account can't use that model) - leave these unset to use the
# code's current defaults, and only set them to switch models without a code change. List what
# your key can use with: GET https://integrate.api.nvidia.com/v1/models
# The model must accept images and support JSON-schema structured output.
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Tried automatically if the primary is retired/erroring. Set to empty to disable.
# NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Anthropic Claude API (only needed if AI_PROVIDER=claude) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Accounts & sessions (multi-user: every seller logs in and connects their own eBay account) ---
# Random 32+ byte secret used to sign session cookies and OAuth "state" values.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Random 32-byte (64 hex char) key used to encrypt each seller's eBay refresh token at rest.
# Generate the same way as SESSION_SECRET above. Losing this key means every seller has to
# reconnect their eBay account - back it up somewhere safe, don't just regenerate it.
TOKEN_ENCRYPTION_KEY=

# The public HTTPS origin this app is reachable at (e.g. your Cloudflare named tunnel's fixed
# hostname). Used to mark session cookies Secure and to build the eBay OAuth callback URL.
PUBLIC_BASE_URL=https://your-tunnel-hostname.example.com

# The account that can post "What's New" updates and read submitted feedback (matched by email
# against the logged-in user - see middleware/auth.js's requireAdmin). Also where feedback
# messages get emailed. Must match the email of an account you've actually signed up with.
ADMIN_EMAIL=

# --- Feedback email (optional - if unset, feedback is still saved to the DB, just not emailed) ---
# Get a free API key at https://resend.com (no credit card required for the free tier).
# Without a verified sending domain on the Resend account, mail can only be delivered to the
# email address that owns the Resend account - fine as long as that's the same as ADMIN_EMAIL.
RESEND_API_KEY=
# FEEDBACK_FROM_EMAIL=onboarding@resend.dev

# --- Storage (optional - only needed when deploying somewhere with a persistent disk mounted
# outside this repo's own directory, e.g. Render; see README's "Deploying to Render" section) ---
# Where the SQLite DB and uploaded photos live. Defaults to ./data and ./uploads if unset, which
# is correct for local dev - leave these blank unless you know you need to override them.
# DATA_DIR=/var/data/db
# UPLOAD_DIR=/var/data/uploads

# --- eBay API (Inventory API, sandbox or production) ---
# Get these from your eBay Developer account (developer.ebay.com). EBAY_CLIENT_ID/SECRET
# identify this app itself and are shared across every seller who connects; each seller's own
# selling authorization comes from their per-user OAuth connection (Settings in the dashboard),
# not from a single global refresh token.
EBAY_ENV=production
# Options: production | sandbox
EBAY_CLIENT_ID=your-app-client-id
EBAY_CLIENT_SECRET=your-app-client-secret
# The RuName registered in your eBay Developer Account (Application Keys > "eBay Redirect URL"),
# whose Accept URL must be set to "<PUBLIC_BASE_URL>/api/ebay/callback". This is a RuName token,
# not a literal URL - see README for the exact setup steps.
EBAY_OAUTH_REDIRECT_URI=your-ebay-runame
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_ID=92074
# 92074 = example "Relays" category on eBay Motors/Industrial - verify your exact category
# (fallback only, for drafts where the per-listing category lookup found nothing)

# --- Cloudflare R2 (public photo hosting for eBay imageUrls) ---
# eBay's Inventory API fetches listing photos itself from a public HTTPS URL - it cannot reach
# localhost - so each photo is uploaded to R2 right before publishing and eBay is given the
# resulting public URL. See README for setup steps.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Database backups (optional but strongly recommended in production) ---
# Daily snapshot of the SQLite database, uploaded to a SEPARATE, PRIVATE R2 bucket. Never point
# this at R2_BUCKET_NAME above: that bucket is publicly readable, and a backup contains every
# seller's email, password hash and encrypted eBay token (the app refuses to back up into it).
# Uses the same R2_ACCOUNT_ID / access key as above - that API token must also have read+write
# access to this bucket. Leave unset to disable backups. See README "Backups".
R2_BACKUP_BUCKET_NAME=
# How many days of daily backups to keep (default 14).
# BACKUP_RETENTION_DAYS=14

# --- AI draft limit ---
# Max AI drafts per seller per rolling 24 hours (default 50). Protects the shared model quota from
# one account (or a script) using it all up. Drafts that fail don't count.
# AI_DAILY_LIMIT=50

PORT=3000