# --- AI provider ---
# Which service drafts listings. "kimi" (Moonshot's Kimi K2.6 via NVIDIA's free NIM tier) or
# "claude" (Anthropic, requires ANTHROPIC_API_KEY below). See services/aiService.js.
AI_PROVIDER=kimi

# --- Kimi K2.6 via NVIDIA NIM (free tier, ~40 req/min) ---
# Get a key at https://build.nvidia.com (sign up free, then Account > API Keys)
NVIDIA_API_KEY=your-nvidia-api-key
# Optional: override the NVIDIA-hosted model (defaults to moonshotai/kimi-k2.6 in code).
# Useful as an escape hatch if a specific model 404s for your account or you want to compare
# a different NVIDIA-hosted model without touching code.
# NVIDIA_MODEL=moonshotai/kimi-k2.6

# --- Anthropic Claude API (only needed if AI_PROVIDER=claude) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Accounts & sessions (multi-user: every seller logs in and connects their own eBay account) ---
# Random 32+ byte secret used to sign session cookies and OAuth "state" values.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Random 32-byte (64 hex char) key used to encrypt each seller's eBay refresh token at rest.
# Generate the same way as SESSION_SECRET above. Losing this key means every seller has to
# reconnect their eBay account - back it up somewhere safe, don't just regenerate it.
TOKEN_ENCRYPTION_KEY=

# The public HTTPS origin this app is reachable at (e.g. your Cloudflare named tunnel's fixed
# hostname). Used to mark session cookies Secure and to build the eBay OAuth callback URL.
PUBLIC_BASE_URL=https://your-tunnel-hostname.example.com

# --- Storage (optional - only needed when deploying somewhere with a persistent disk mounted
# outside this repo's own directory, e.g. Render; see README's "Deploying to Render" section) ---
# Where the SQLite DB and uploaded photos live. Defaults to ./data and ./uploads if unset, which
# is correct for local dev - leave these blank unless you know you need to override them.
# DATA_DIR=/var/data/db
# UPLOAD_DIR=/var/data/uploads

# --- eBay API (Inventory API, sandbox or production) ---
# Get these from your eBay Developer account (developer.ebay.com). EBAY_CLIENT_ID/SECRET
# identify this app itself and are shared across every seller who connects; each seller's own
# selling authorization comes from their per-user OAuth connection (Settings in the dashboard),
# not from a single global refresh token.
EBAY_ENV=production
# Options: production | sandbox
EBAY_CLIENT_ID=your-app-client-id
EBAY_CLIENT_SECRET=your-app-client-secret
# The RuName registered in your eBay Developer Account (Application Keys > "eBay Redirect URL"),
# whose Accept URL must be set to "<PUBLIC_BASE_URL>/api/ebay/callback". This is a RuName token,
# not a literal URL - see README for the exact setup steps.
EBAY_OAUTH_REDIRECT_URI=your-ebay-runame
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_ID=92074
# 92074 = example "Relays" category on eBay Motors/Industrial - verify your exact category
# (fallback only, for drafts where the per-listing category lookup found nothing)

# --- Cloudflare R2 (public photo hosting for eBay imageUrls) ---
# eBay's Inventory API fetches listing photos itself from a public HTTPS URL - it cannot reach
# localhost - so each photo is uploaded to R2 right before publishing and eBay is given the
# resulting public URL. See README for setup steps.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

PORT=3000