# --- Anthropic Claude API ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- eBay API (Inventory API, sandbox or production) ---
# Get these from your eBay Developer account (developer.ebay.com)
EBAY_ENV=production
# Options: production | sandbox
EBAY_CLIENT_ID=your-app-client-id
EBAY_CLIENT_SECRET=your-app-client-secret
# OAuth refresh token generated via eBay's user consent flow (see README)
EBAY_REFRESH_TOKEN=your-ebay-refresh-token
EBAY_MERCHANT_LOCATION_KEY=your-warehouse-location-key
EBAY_FULFILLMENT_POLICY_ID=your-fulfillment-policy-id
EBAY_PAYMENT_POLICY_ID=your-payment-policy-id
EBAY_RETURN_POLICY_ID=your-return-policy-id
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_ID=92074
# 92074 = example "Relays" category on eBay Motors/Industrial - verify your exact category

# --- Public URL for serving uploaded photos to eBay ---
# eBay's Inventory API fetches listing images from public HTTPS URLs - it cannot reach localhost.
# `npm run start:tunnel` starts ngrok and this app together and fills this in for you automatically.
# For manual setup: run `ngrok http 3000` in a separate terminal and paste the https URL it prints
# here (it changes each time you restart ngrok on the free tier). For a real deployment, use your
# app's real public domain instead.
PUBLIC_BASE_URL=https://your-tunnel-or-domain.example.com

# Only needed if `ngrok` isn't on your PATH (e.g. you haven't opened a new terminal since
# installing it) - set to ngrok's full executable path instead. Leave unset otherwise.
# NGROK_PATH=C:\Users\you\AppData\Local\Microsoft\WindowsApps\ngrok.exe

PORT=3000
