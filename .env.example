# --- AI provider ---
# Which service drafts listings. "kimi" (Moonshot's Kimi K2.6 via NVIDIA's free NIM tier) or
# "claude" (Anthropic, requires ANTHROPIC_API_KEY below). See services/aiService.js.
AI_PROVIDER=kimi

# --- Kimi K2.6 via NVIDIA NIM (free tier, ~40 req/min) ---
# Get a key at https://build.nvidia.com (sign up free, then Account > API Keys)
NVIDIA_API_KEY=your-nvidia-api-key
# Optional: override the NVIDIA-hosted model (defaults to moonshotai/kimi-k2.6 in code).
# Useful as an escape hatch if a specific model 404s for your account or you want to compare
# a different NVIDIA-hosted model without touching code.
# NVIDIA_MODEL=moonshotai/kimi-k2.6

# --- Anthropic Claude API (only needed if AI_PROVIDER=claude) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- eBay API (Inventory API, sandbox or production) ---
# Get these from your eBay Developer account (developer.ebay.com)
EBAY_ENV=production
# Options: production | sandbox
EBAY_CLIENT_ID=your-app-client-id
EBAY_CLIENT_SECRET=your-app-client-secret
# OAuth refresh token generated via eBay's user consent flow (see README)
EBAY_REFRESH_TOKEN=your-ebay-refresh-token
EBAY_MERCHANT_LOCATION_KEY=your-warehouse-location-key
EBAY_FULFILLMENT_POLICY_ID=your-fulfillment-policy-id
EBAY_PAYMENT_POLICY_ID=your-payment-policy-id
EBAY_RETURN_POLICY_ID=your-return-policy-id
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_ID=92074
# 92074 = example "Relays" category on eBay Motors/Industrial - verify your exact category

# --- Cloudflare R2 (public photo hosting for eBay imageUrls) ---
# eBay's Inventory API fetches listing photos itself from a public HTTPS URL - it cannot reach
# localhost - so each photo is uploaded to R2 right before publishing and eBay is given the
# resulting public URL. See README for setup steps.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

PORT=3000